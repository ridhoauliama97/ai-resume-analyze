# Database
DATABASE_URL=postgres://resume:resume@localhost:5432/resume_analyzer
TEST_DATABASE_URL=postgres://resume:resume@localhost:5432/resume_analyzer_test

# AI providers
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=

# Anonymous client token hashing (use a long random value)
CLIENT_TOKEN_PEPPER=replace-with-a-long-random-string

# Admin dashboard credentials (change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Set to 1 only for local development or tests. Never use in production.
AI_MOCK=0
