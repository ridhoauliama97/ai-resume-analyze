# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Docker Postgres from docker-compose.yml
DATABASE_URL=postgres://resume:resume@localhost:5432/resume_analyzer
TEST_DATABASE_URL=postgres://resume:resume@localhost:5432/resume_analyzer_test

# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
TAVILY_API_KEY=

# ---------------------------------------------------------------------------
# Anonymous client + admin session
# ---------------------------------------------------------------------------
# Use a long random value in every environment.
CLIENT_TOKEN_PEPPER=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ---------------------------------------------------------------------------
# Supabase Storage (server-side S3 credentials; keep secret)
# ---------------------------------------------------------------------------
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=<project-region>
SUPABASE_S3_ACCESS_KEY_ID=replace-with-s3-access-key-id
SUPABASE_S3_SECRET_ACCESS_KEY=replace-with-s3-secret-access-key
SUPABASE_STORAGE_BUCKET=resumes

# ---------------------------------------------------------------------------
# Production / Vercel
# ---------------------------------------------------------------------------
# For Vercel, DATABASE_URL must be the Supabase Transaction Pooler URL
# (IPv4, port 6543). The direct connection is IPv6-only and Vercel is IPv4-only.
#
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# Keep the serverless pool small; postgres-js disables prepared statements
# automatically for pooler compatibility.
DB_MAX_CONNECTIONS=3
AI_MOCK=0
